@page "/registroaves"
@using Simulacro.Models
@using Simulacro.Services

@inject RegistroAnimales RegistroService
@inject NavigationManager Navigation

<h3>Registro de Aves</h3>

<div class="card p-3 m-4">
    <div class="row">

        <div class="col-md-6 mb-3">
            <label>Nombre del ave:</label>
            <input type="text" class="form-control" @bind="ave.nombre" />
        </div>
        <div class="col-md-6 mb-3">
            <label>Edad del ave:</label>
            <input type="text" class="form-control" @bind="ave.edad" />
        </div>
        <div class="col-md-6 mb-3">
            <label>Altura del ave:</label>
            <input type="text" class="form-control" @bind="ave.altura" />
        </div>

        <div class="col-md-6 mb-3">
            <label>Tipo de Pico:</label>
            <select class="form-control" @bind="ave.TipoPicoSeleccionado">
                @foreach (var pico in Enum.GetValues(typeof(TipoPico)))
                {
                    <option value="@pico">@pico</option>
                }
            </select>
        </div>

        <div class="col-md-6 mb-3 d-flex align-items-center mt-4">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="checkVolar" @bind="ave.puedeVolar" />
                <label class="form-check-label" for="checkVolar">¿Esta ave puede volar?</label>
            </div>
        </div>
    </div>

    <!-- Botón para accionar el guardado -->
    <div class="row mt-3">
        <div class="col-12">
            <button class="btn btn-success" @onclick="GuardarAve">Guardar Ave</button>
        </div>
    </div>
</div>

@code {
    private Ave ave = new Ave();

    private void GuardarAve()
    {

        ave.especie = "Ave";

        RegistroService.GuardarAves(ave);


        Navigation.NavigateTo("/listado-aves");
    }
}
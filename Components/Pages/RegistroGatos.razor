@page "/registrogatos"
@using Simulacro.Models
@using Simulacro.Services

@inject RegistroAnimales RegistroService
@inject NavigationManager Navigation

<h3>Registro de Gatos</h3>

<div class="card p-3 m-4">
    <div class="row">
        <!-- Campos base heredados de Animales -->
        <div class="col-md-6 mb-3">
            <label>Nombre del gato:</label>
            <input type="text" class="form-control" @bind="gato.nombre" />
        </div>
        <div class="col-md-6 mb-3">
            <label>Edad del gato:</label>
            <input type="text" class="form-control" @bind="gato.edad" />
        </div>
        <div class="col-md-6 mb-3">
            <label>Altura del gato:</label>
            <input type="text" class="form-control" @bind="gato.altura" />
        </div>

        <!-- Selector del Enum para Tipo de Pelaje -->
        <div class="col-md-6 mb-3">
            <label>Tipo de Pelaje:</label>
            <select class="form-control" @bind="gato.TipoPelajeSeleccionado">
                @foreach (var pelaje in Enum.GetValues(typeof(TipoPelaje)))
                {
                    <option value="@pelaje">@pelaje</option>
                }
            </select>
        </div>

        <!-- Campo Booleano para si es Doméstico -->
        <div class="col-md-6 mb-3 d-flex align-items-center mt-4">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="checkDomestico" @bind="gato.esDomestico" />
                <label class="form-check-label" for="checkDomestico">¿Es un gato doméstico?</label>
            </div>
        </div>
    </div>

    <!-- Botón para accionar el guardado -->
    <div class="row mt-3">
        <div class="col-12">
            <button class="btn btn-success" @onclick="GuardarGato">Guardar Gato</button>
        </div>
    </div>
</div>

@code {
    private Gato gato = new Gato();

    private void GuardarGato()
    {
        // Forzamos el valor de la especie para el registro
        gato.especie = "Gato";

        // Llama a tu método existente en RegistroAnimales para persistir en el JSON
        RegistroService.GuardarGatos(gato);

        // Redirección al listado correspondiente
        Navigation.NavigateTo("/listado-gatos");
    }
}
@page "/registroperros"
@using Simulacro.Models
@using Simulacro.Services

@inject RegistroAnimales RegistroService
@inject NavigationManager Navigation

<h3>Registro de Perros</h3>

<div class="card p-3 m-4">
    <div class="row">
        <div class="col-md-6 mb-3">
            <label>Nombre del perro:</label>
            <input type="text" class="form-control" @bind="perro.nombre" />
        </div>
        <div class="col-md-6 mb-3">
            <label>Edad del perro:</label>
            <input type="text" class="form-control" @bind="perro.edad" />
        </div>
        <div class="col-md-6 mb-3">
            <label>Altura del perro:</label>
            <input type="text" class="form-control" @bind="perro.altura" />
        </div>
        <div class="col-md-6 mb-3">
            <label>Raza del perro:</label>
            <input type="text" class="form-control" @bind="perro.raza" />
        </div>

        <!-- CORREGIDO PARA BLAZOR -->
        <div class="col-md-6 mb-3">
            <label>Tamaño del Perro:</label>
            <select class="form-control" @bind="perro.TamañoSeleccionado">
                @foreach (var tamano in Enum.GetValues(typeof(TamañoAnimal)))
                {
                    <option value="@tamano">@tamano</option>
                }
            </select>
        </div>
    </div>

    <!-- Botón para accionar el guardado -->
    <div class="row mt-3">
        <div class="col-12">
            <button class="btn btn-success" @onclick="GuardarPerro">Guardar Perro</button>
        </div>
    </div>
</div>

@code {
    private Perro perro = new Perro();

    private void GuardarPerro()
    {
        // Forzamos el valor de la especie ya que estamos en el formulario de perros
        perro.especie = "Perro";

        RegistroService.GuardarPerros(perro);
        Navigation.NavigateTo("/listado-perros");
    }
}